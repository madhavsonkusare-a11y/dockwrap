{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "langflow",
      "image": "langflowai/langflow:1.12.1",
      "isMain": true,
      "internalPort": 7860,
      "environment": [
        {
          "key": "LANGFLOW_CONFIG_DIR",
          "value": "/app/langflow"
        },
        {
          "key": "LANGFLOW_SECRET_KEY",
          "value": "${LANGFLOW_SECRET_KEY}"
        },
        {
          "key": "DO_NOT_TRACK",
          "value": "true"
        },
        {
          "key": "LANGFLOW_SUPERUSER",
          "value": "${LANGFLOW_USERNAME}"
        },
        {
          "key": "LANGFLOW_SUPERUSER_PASSWORD",
          "value": "${LANGFLOW_PASSWORD}"
        },
        {
          "key": "LANGFLOW_AUTO_LOGIN",
          "value": "false"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/langflow"
        }
      ]
    }
  ]
}
