{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "paperclip",
      "image": "ghcr.io/paperclipai/paperclip:2026.831.1",
      "isMain": true,
      "internalPort": 3100,
      "environment": [
        {
          "key": "HOST",
          "value": "0.0.0.0"
        },
        {
          "key": "PORT",
          "value": "3100"
        },
        {
          "key": "PAPERCLIP_HOME",
          "value": "/paperclip"
        },
        {
          "key": "PAPERCLIP_DEPLOYMENT_MODE",
          "value": "authenticated"
        },
        {
          "key": "PAPERCLIP_DEPLOYMENT_EXPOSURE",
          "value": "private"
        },
        {
          "key": "PAPERCLIP_PUBLIC_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "BETTER_AUTH_SECRET",
          "value": "${PAPERCLIP_AUTH_SECRET}"
        },
        {
          "key": "ANTHROPIC_API_KEY",
          "value": "${ANTHROPIC_API_KEY}"
        },
        {
          "key": "OPENAI_API_KEY",
          "value": "${OPENAI_API_KEY}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/paperclip"
        }
      ]
    }
  ]
}
