{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "flowise",
      "image": "flowiseai/flowise:3.1.4",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "PORT",
          "value": "3000"
        },
        {
          "key": "SECRETKEY_PATH",
          "value": "/home/node/.flowise"
        },
        {
          "key": "LOG_PATH",
          "value": "/home/node/.flowise/logs"
        },
        {
          "key": "BLOB_STORAGE_PATH",
          "value": "/home/node/.flowise/storage"
        },
        {
          "key": "APP_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "JWT_AUTH_TOKEN_SECRET",
          "value": "${FLOWISE_JWT_SECRET}"
        },
        {
          "key": "JWT_REFRESH_TOKEN_SECRET",
          "value": "${FLOWISE_JWT_REFRESH_SECRET}"
        },
        {
          "key": "EXPRESS_SESSION_SECRET",
          "value": "${FLOWISE_SESSION_SECRET}"
        },
        {
          "key": "TOKEN_HASH_SECRET",
          "value": "${FLOWISE_TOKEN_HASH_SECRET}"
        },
        {
          "key": "DISABLE_FLOWISE_TELEMETRY",
          "value": "true"
        },
        {
          "key": "DATABASE_TYPE",
          "value": "postgres"
        },
        {
          "key": "DATABASE_HOST",
          "value": "flowise-db"
        },
        {
          "key": "DATABASE_PORT",
          "value": "5432"
        },
        {
          "key": "DATABASE_NAME",
          "value": "flowise"
        },
        {
          "key": "DATABASE_USER",
          "value": "postgres"
        },
        {
          "key": "DATABASE_PASSWORD",
          "value": "${FLOWISE_DB_PASSWORD}"
        },
        {
          "key": "DATABASE_SSL",
          "value": "false"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/home/node/.flowise"
        }
      ],
      "dependsOn": {
        "flowise-db": {
          "condition": "service_healthy"
        }
      }
    },
    {
      "name": "flowise-db",
      "image": "postgres:17.11",
      "stopSignal": "SIGINT",
      "environment": [
        {
          "key": "POSTGRES_USER",
          "value": "postgres"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${FLOWISE_DB_PASSWORD}"
        },
        {
          "key": "POSTGRES_DB",
          "value": "flowise"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U postgres",
        "interval": "5s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "60s"
      }
    }
  ]
}
