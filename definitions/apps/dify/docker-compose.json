{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "networks": {
    "dify-sandbox-net": {
      "internal": true
    },
    "dify-agent-net": {
      "internal": true
    },
    "dify-agent-proxy-net": {
      "internal": true
    }
  },
  "services": [
    {
      "name": "dify",
      "image": "nginx:1.31.5-alpine",
      "isMain": true,
      "internalPort": 80,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/nginx/default.conf",
          "containerPath": "/etc/nginx/conf.d/default.conf",
          "readOnly": true
        }
      ],
      "dependsOn": [
        "dify-api",
        "dify-web"
      ]
    },
    {
      "name": "dify-api",
      "image": "langgenius/dify-api:1.17.1",
      "environment": [
        {
          "key": "MODE",
          "value": "api"
        },
        {
          "key": "SECRET_KEY",
          "value": "${DIFY_SECRET_KEY}"
        },
        {
          "key": "DEPLOY_ENV",
          "value": "PRODUCTION"
        },
        {
          "key": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "key": "MIGRATION_ENABLED",
          "value": "true"
        },
        {
          "key": "FILES_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "INTERNAL_FILES_URL",
          "value": "http://dify-api:5001"
        },
        {
          "key": "TRIGGER_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "ENDPOINT_URL_TEMPLATE",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}/e/{hook_id}"
        },
        {
          "key": "ENABLE_COLLABORATION_MODE",
          "value": "true"
        },
        {
          "key": "DB_TYPE",
          "value": "postgresql"
        },
        {
          "key": "DB_USERNAME",
          "value": "postgres"
        },
        {
          "key": "DB_PASSWORD",
          "value": "${DIFY_DB_PASSWORD}"
        },
        {
          "key": "DB_HOST",
          "value": "dify-db"
        },
        {
          "key": "DB_PORT",
          "value": "5432"
        },
        {
          "key": "DB_DATABASE",
          "value": "dify"
        },
        {
          "key": "REDIS_HOST",
          "value": "dify-redis"
        },
        {
          "key": "REDIS_PORT",
          "value": "6379"
        },
        {
          "key": "REDIS_DB",
          "value": "0"
        },
        {
          "key": "CELERY_BROKER_URL",
          "value": "redis://dify-redis:6379/1"
        },
        {
          "key": "CELERY_BACKEND",
          "value": "redis"
        },
        {
          "key": "STORAGE_TYPE",
          "value": "opendal"
        },
        {
          "key": "OPENDAL_SCHEME",
          "value": "fs"
        },
        {
          "key": "OPENDAL_FS_ROOT",
          "value": "storage"
        },
        {
          "key": "VECTOR_STORE",
          "value": "pgvector"
        },
        {
          "key": "PGVECTOR_HOST",
          "value": "dify-db"
        },
        {
          "key": "PGVECTOR_PORT",
          "value": "5432"
        },
        {
          "key": "PGVECTOR_USER",
          "value": "postgres"
        },
        {
          "key": "PGVECTOR_PASSWORD",
          "value": "${DIFY_DB_PASSWORD}"
        },
        {
          "key": "PGVECTOR_DATABASE",
          "value": "dify"
        },
        {
          "key": "CODE_EXECUTION_ENDPOINT",
          "value": "http://dify-sandbox:8194"
        },
        {
          "key": "CODE_EXECUTION_API_KEY",
          "value": "${DIFY_SANDBOX_KEY}"
        },
        {
          "key": "SSRF_PROXY_HTTP_URL",
          "value": "http://dify-ssrf-proxy:3128"
        },
        {
          "key": "SSRF_PROXY_HTTPS_URL",
          "value": "http://dify-ssrf-proxy:3128"
        },
        {
          "key": "PLUGIN_DAEMON_URL",
          "value": "http://dify-plugin-daemon:5002"
        },
        {
          "key": "PLUGIN_DAEMON_KEY",
          "value": "${DIFY_PLUGIN_DAEMON_KEY}"
        },
        {
          "key": "INNER_API_KEY_FOR_PLUGIN",
          "value": "${DIFY_INNER_API_KEY}"
        },
        {
          "key": "MARKETPLACE_ENABLED",
          "value": "true"
        },
        {
          "key": "MARKETPLACE_API_URL",
          "value": "https://marketplace.dify.ai"
        },
        {
          "key": "AGENT_BACKEND_BASE_URL",
          "value": "http://dify-agent-backend:5050"
        },
        {
          "key": "AGENT_BACKEND_API_TOKEN",
          "value": "${DIFY_AGENT_API_TOKEN}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/app/api/storage"
        }
      ],
      "networks": [
        "default",
        "dify-sandbox-net"
      ],
      "healthCheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:5001/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "startPeriod": "30s"
      },
      "dependsOn": {
        "dify-init": {
          "condition": "service_completed_successfully"
        },
        "dify-db": {
          "condition": "service_healthy"
        },
        "dify-redis": {
          "condition": "service_healthy"
        },
        "dify-agent-backend": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "dify-api-websocket",
