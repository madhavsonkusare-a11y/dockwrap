    {
      "name": "dify-web",
      "image": "langgenius/dify-web:1.17.1",
      "environment": [
        {
          "key": "CONSOLE_API_URL",
          "value": ""
        },
        {
          "key": "APP_API_URL",
          "value": ""
        },
        {
          "key": "SERVER_CONSOLE_API_URL",
          "value": "http://dify-api:5001"
        },
        {
          "key": "NEXT_PUBLIC_SOCKET_URL",
          "value": "ws://${APP_DOMAIN}"
        },
        {
          "key": "NEXT_TELEMETRY_DISABLED",
          "value": "1"
        },
        {
          "key": "MARKETPLACE_API_URL",
          "value": "https://marketplace.dify.ai"
        },
        {
          "key": "MARKETPLACE_URL",
          "value": "https://marketplace.dify.ai"
        },
        {
          "key": "NEXT_PUBLIC_ENABLE_AGENT_V2",
          "value": "true"
        }
      ]
    },
    {
      "name": "dify-db",
      "image": "pgvector/pgvector:0.8.6-pg15",
      "stopSignal": "SIGINT",
      "command": [
        "postgres",
        "-c",
        "max_connections=100",
        "-c",
        "shared_buffers=128MB",
        "-c",
        "work_mem=4MB",
        "-c",
        "maintenance_work_mem=64MB",
        "-c",
        "effective_cache_size=4096MB"
      ],
      "environment": [
        {
          "key": "POSTGRES_USER",
          "value": "postgres"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${DIFY_DB_PASSWORD}"
        },
        {
          "key": "POSTGRES_DB",
          "value": "dify"
        },
        {
          "key": "PGDATA",
          "value": "/var/lib/postgresql/data/pgdata"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-d",
          "dify"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 60,
        "startPeriod": "60s"
      }
    },
    {
      "name": "dify-redis",
      "image": "redis:7.4.11-alpine",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/redis",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "test": [
          "CMD-SHELL",
          "redis-cli ping | grep -q PONG"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 10
      }
    },
    {
      "name": "dify-sandbox",
      "image": "langgenius/dify-sandbox:0.2.15",
      "environment": [
        {
          "key": "API_KEY",
          "value": "${DIFY_SANDBOX_KEY}"
        },
        {
          "key": "GIN_MODE",
          "value": "release"
        },
        {
          "key": "WORKER_TIMEOUT",
          "value": "15"
        },
        {
          "key": "ENABLE_NETWORK",
          "value": "true"
        },
        {
          "key": "HTTP_PROXY",
          "value": "http://dify-ssrf-proxy:3128"
        },
        {
          "key": "HTTPS_PROXY",
          "value": "http://dify-ssrf-proxy:3128"
        },
        {
          "key": "SANDBOX_PORT",
          "value": "8194"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/sandbox/dependencies",
          "containerPath": "/dependencies"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/sandbox/conf",
          "containerPath": "/conf"
        }
      ],
      "networks": [
        "dify-sandbox-net"
      ],
      "healthCheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8194/health"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    },
    {
      "name": "dify-ssrf-proxy",
      "image": "ubuntu/squid:6.6-24.04_edge",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/ssrf-proxy/squid.conf",
          "containerPath": "/etc/squid/squid.conf",
          "readOnly": true
        }
      ],
      "networks": [
        "default",
        "dify-sandbox-net"
      ]
    },
    {
      "name": "dify-plugin-daemon",
      "image": "langgenius/dify-plugin-daemon:0.6.10-local",
      "environment": [
        {
          "key": "DB_TYPE",
          "value": "postgresql"
        },
        {
          "key": "DB_HOST",
          "value": "dify-db"
        },
        {
          "key": "DB_PORT",
          "value": "5432"
        },
        {
          "key": "DB_USERNAME",
          "value": "postgres"
        },
        {
          "key": "DB_PASSWORD",
          "value": "${DIFY_DB_PASSWORD}"
        },
        {
          "key": "DB_DATABASE",
          "value": "dify_plugin"
        },
        {
          "key": "DB_SSL_MODE",
          "value": "disable"
        },
        {
          "key": "REDIS_HOST",
          "value": "dify-redis"
        },
        {
          "key": "REDIS_PORT",
          "value": "6379"
        },
        {
          "key": "SERVER_PORT",
          "value": "5002"
        },
        {
          "key": "SERVER_KEY",
          "value": "${DIFY_PLUGIN_DAEMON_KEY}"
        },
        {
          "key": "MAX_PLUGIN_PACKAGE_SIZE",
          "value": "52428800"
        },
        {
          "key": "DIFY_INNER_API_URL",
          "value": "http://dify-api:5001"
        },
        {
          "key": "DIFY_INNER_API_KEY",
          "value": "${DIFY_INNER_API_KEY}"
        },
        {
          "key": "PLUGIN_REMOTE_INSTALLING_HOST",
          "value": "0.0.0.0"
        },
        {
          "key": "PLUGIN_REMOTE_INSTALLING_PORT",
          "value": "5003"
        },
        {
          "key": "PLUGIN_WORKING_PATH",
          "value": "/app/storage/cwd"
        },
        {
          "key": "FORCE_VERIFYING_SIGNATURE",
          "value": "true"
        },
        {
          "key": "PYTHON_ENV_INIT_TIMEOUT",
          "value": "120"
        },
        {
          "key": "PLUGIN_MAX_EXECUTION_TIMEOUT",
          "value": "600"
        },
        {
          "key": "PLUGIN_STORAGE_TYPE",
          "value": "local"
        },
        {
          "key": "PLUGIN_STORAGE_LOCAL_ROOT",
          "value": "/app/storage"
        },
        {
          "key": "PLUGIN_INSTALLED_PATH",
          "value": "plugin"
        },
        {
          "key": "PLUGIN_PACKAGE_CACHE_PATH",
          "value": "plugin_packages"
        },
        {
          "key": "PLUGIN_MEDIA_CACHE_PATH",
          "value": "assets"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/plugin-daemon",
          "containerPath": "/app/storage"
        }
      ],
      "networks": [
        "default",
        "dify-sandbox-net"
      ],
      "dependsOn": {
        "dify-db": {
          "condition": "service_healthy"
        },
        "dify-redis": {
          "condition": "service_healthy"
        }
      }
    },
    {
      "name": "dify-agent-backend",
      "image": "langgenius/dify-agent-backend:1.17.1",
      "environment": [
        {
          "key": "DIFY_AGENT_REDIS_URL",
          "value": "redis://dify-redis:6379/2"
        },
        {
          "key": "DIFY_AGENT_PLUGIN_DAEMON_URL",
          "value": "http://dify-plugin-daemon:5002"
        },
        {
          "key": "DIFY_AGENT_PLUGIN_DAEMON_API_KEY",
          "value": "${DIFY_PLUGIN_DAEMON_KEY}"
        },
        {
          "key": "DIFY_AGENT_INNER_API_URL",
          "value": "http://dify-api:5001"
        },
        {
          "key": "DIFY_AGENT_INNER_API_KEY",
          "value": "${DIFY_INNER_API_KEY}"
        },
        {
          "key": "DIFY_AGENT_RUNTIME_BACKEND",
          "value": "local"
        },
        {
          "key": "DIFY_AGENT_LOCAL_SANDBOX_ENDPOINT",
          "value": "http://dify-agent-sandbox:5004"
        },
        {
          "key": "DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN",
          "value": "${DIFY_AGENT_SANDBOX_TOKEN}"
        },
        {
          "key": "DIFY_AGENT_STUB_API_BASE_URL",
          "value": "http://dify-agent-backend:5050/agent-stub"
        },
        {
          "key": "DIFY_AGENT_SANDBOX_FILES_BASE_URL",
          "value": "http://dify-api:5001"
        },
        {
          "key": "DIFY_AGENT_SERVER_SECRET_KEY",
          "value": "${DIFY_AGENT_SERVER_SECRET}"
        },
        {
          "key": "DIFY_AGENT_API_TOKEN",
          "value": "${DIFY_AGENT_API_TOKEN}"
        }
      ],
      "networks": [
        "default",
        "dify-agent-net"
      ],
      "dependsOn": {
        "dify-redis": {
          "condition": "service_healthy"
        },
        "dify-plugin-daemon": {
          "condition": "service_started"
        }
      }
    },
    {
      "name": "dify-agent-sandbox",
      "image": "langgenius/dify-agent-local-sandbox:1.17.1",
      "environment": [
        {
          "key": "SHELLCTL_AUTH_TOKEN",
          "value": "${DIFY_AGENT_SANDBOX_TOKEN}"
        },
        {
          "key": "SHELLCTL_ENABLE_PATH_ISOLATION",
          "value": "true"
        },
        {
          "key": "HTTP_PROXY",
          "value": "http://dify-agent-proxy:3128"
        },
        {
          "key": "HTTPS_PROXY",
          "value": "http://dify-agent-proxy:3128"
        },
        {
          "key": "NO_PROXY",
          "value": "localhost,127.0.0.1"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/agent-sandbox/home",
          "containerPath": "/home/dify"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/agent-sandbox/workspace",
          "containerPath": "/workspace"
        }
      ],
      "networks": [
        "dify-agent-net",
        "dify-agent-proxy-net"
      ],
      "healthCheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:5004/healthz"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "startPeriod": "10s"
      }
    },
    {
      "name": "dify-agent-proxy",
      "image": "ubuntu/squid:6.6-24.04_edge",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/agent-proxy/squid.conf",
          "containerPath": "/etc/squid/squid.conf",
          "readOnly": true
        }
      ],
      "networks": [
        "default",
        "dify-agent-proxy-net"
      ]
    },
    {
      "name": "dify-init",
      "image": "busybox:1.37.0",
      "command": [
        "sh",
        "-c",
        "if [ -f /app/api/storage/.init_permissions ]; then exit 0; fi; chown -R 1001:1001 /app/api/storage && touch /app/api/storage/.init_permissions"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/app/api/storage"
        }
      ]
    }
  ]
}
