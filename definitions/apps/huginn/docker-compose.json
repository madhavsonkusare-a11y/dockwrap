{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "huginn",
      "image": "ghcr.io/huginn/huginn:v2026.09.09",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "APP_SECRET_TOKEN",
          "value": "${HUGINN_SECRET_TOKEN}"
        },
        {
          "key": "DOMAIN",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "SEED_USERNAME",
          "value": "${HUGINN_USERNAME}"
        },
        {
          "key": "SEED_PASSWORD",
          "value": "${HUGINN_PASSWORD}"
        },
        {
          "key": "SEED_EMAIL",
          "value": "${HUGINN_EMAIL}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/mysql",
          "containerPath": "/var/lib/mysql"
        }
      ]
    }
  ]
}
