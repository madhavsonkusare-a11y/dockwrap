{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "anythingllm",
      "image": "mintplexlabs/anythingllm:1.16.1",
      "isMain": true,
      "internalPort": 3001,
      "environment": [
        {
          "key": "STORAGE_DIR",
          "value": "/app/server/storage"
        },
        {
          "key": "JWT_SECRET",
          "value": "${ANYTHINGLLM_JWT_SECRET}"
        },
        {
          "key": "DISABLE_TELEMETRY",
          "value": "true"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/storage",
          "containerPath": "/app/server/storage"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/.env",
          "containerPath": "/app/server/.env"
        }
      ]
    }
  ]
}
