{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "ghostfolio",
      "image": "ghostfolio/ghostfolio:3.69.0",
      "isMain": true,
      "internalPort": 3333,
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "HOST",
          "value": "0.0.0.0"
        },
        {
          "key": "PORT",
          "value": "3333"
        },
        {
          "key": "ACCESS_TOKEN_SALT",
          "value": "${GHOSTFOLIO_ACCESS_TOKEN_SALT}"
        },
        {
          "key": "JWT_SECRET_KEY",
          "value": "${GHOSTFOLIO_JWT_SECRET_KEY}"
        },
        {
          "key": "DATABASE_URL",
          "value": "postgresql://ghostfolio:${GHOSTFOLIO_DB_PASSWORD}@ghostfolio-db:5432/ghostfolio"
        },
        {
          "key": "POSTGRES_DB",
          "value": "ghostfolio"
        },
        {
          "key": "POSTGRES_USER",
          "value": "ghostfolio"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${GHOSTFOLIO_DB_PASSWORD}"
        },
        {
          "key": "REDIS_HOST",
          "value": "ghostfolio-redis"
        },
        {
          "key": "REDIS_PORT",
          "value": "6379"
        },
        {
          "key": "REDIS_PASSWORD",
          "value": "${GHOSTFOLIO_REDIS_PASSWORD}"
        }
      ],
      "dependsOn": {
        "ghostfolio-db": {
          "condition": "service_healthy"
        },
        "ghostfolio-redis": {
          "condition": "service_healthy"
        }
      }
    },
    {
      "name": "ghostfolio-db",
      "image": "postgres:17.11",
      "stopSignal": "SIGINT",
      "environment": [
        {
          "key": "POSTGRES_DB",
          "value": "ghostfolio"
        },
        {
          "key": "POSTGRES_USER",
          "value": "ghostfolio"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${GHOSTFOLIO_DB_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U ghostfolio -d ghostfolio",
        "interval": "5s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "60s"
      }
    },
    {
      "name": "ghostfolio-redis",
      "image": "redis:7.4.11-alpine",
      "command": [
        "sh",
        "-c",
        "exec redis-server --requirepass \"$$REDISCLI_AUTH\""
      ],
      "environment": [
        {
          "key": "REDISCLI_AUTH",
          "value": "${GHOSTFOLIO_REDIS_PASSWORD}"
        }
      ],
      "healthCheck": {
        "test": ["CMD-SHELL", "redis-cli ping | grep -q PONG"],
        "interval": "5s",
        "timeout": "3s",
        "retries": 10,
        "startPeriod": "20s"
      }
    }
  ]
}
