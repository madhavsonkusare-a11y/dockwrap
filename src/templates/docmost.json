  "promotion": {
    "state": "approved",
    "reason": "Approved by the owner. Qualified as offered on 2026-09-12: a real install of Docmost 0.96.0, upstream's current release proved it starts, opens to a first screen with a clear next step, survives a restart and a keep-data reinstall with its data and generated credentials intact, and removes everything it created. The definition comes from Runtipi's app store."
  },
  "data_storage": "Local Store managed folder / docmost",
  "risk_notes": [
    "Creates 3 Docker containers and publishes one port on this computer's loopback interface only.",
    "Generates 2 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps its data in this app's managed folder. A keep-data uninstall leaves it; deleting data removes it permanently.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Asks you to create the first workspace and account, which becomes the administrator.",
    "Pages, uploads and attachments live in the app's folder, in PostgreSQL and on disk beside it.",
    "Docmost is source-available: the code here is AGPL-3.0, and some features belong to a separately licensed edition."
  ],
  "fields": {},
  "definition": "{\n  \"services\": [\n    {\n      \"name\": \"docmost\",\n      \"image\": \"docmost/docmost:0.95.0\",\n      \"isMain\": true,\n      \"internalPort\": 3000,\n      \"environment\": [\n        {\n          \"key\": \"APP_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"APP_SECRET\",\n          \"value\": \"${DOCMOST_APP_SECRET}\"\n        },\n        {\n          \"key\": \"DATABASE_URL\",\n          \"value\": \"postgresql://docmost:${DOCMOST_PG_PASSWORD}@docmost-db:5432/docmost?schema\"\n        },\n        {\n          \"key\": \"REDIS_URL\",\n          \"value\": \"redis://docmost-redis:6379\"\n        }\n      ],\n      \"dependsOn\": [\"docmost-db\", \"docmost-redis\"],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/storage\",\n          \"containerPath\": \"/app/data/storage\"\n        }\n      ]\n    },\n    {\n      \"name\": \"docmost-db\",\n      \"image\": \"postgres:16-alpine\",\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"docmost\"\n        },\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"docmost\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${DOCMOST_PG_PASSWORD}\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/postgresql\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ]\n    },\n    {\n      \"name\": \"docmost-redis\",\n      \"image\": \"redis:7.2-alpine\",\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/redis\",\n          \"containerPath\": \"/data\"\n        }\n      ]\n    }\n  ],\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\"\n}\n",
  "config": {
    "path": "apps/docmost/config.json",
    "content": "{\n  \"name\": \"Docmost\",\n  \"id\": \"docmost\",\n  \"available\": true,\n  \"short_desc\": \"An open-source collaborative wiki and documentation software\",\n  \"author\": \"docmost\",\n  \"port\": 9713,\n  \"categories\": [\"data\", \"utilities\"],\n  \"description\": \"Docmost is an open-source alternative to the likes of Notion and Confluence. Whether you're managing a wiki, a knowledge base, or extensive project documentation, Docmost provides the tools you need to create, collaborate, and share knowledge effortlessly.\",\n  \"tipi_version\": 64,\n  \"version\": \"0.95.0\",\n  \"source\": \"https://github.com/docmost/docmost\",\n  \"website\": \"https://docmost.com/\",\n  \"exposable\": true,\n  \"dynamic_config\": true,\n  \"force_expose\": false,\n  \"form_fields\": [\n    {\n      \"type\": \"random\",\n      \"label\": \"App Secret\",\n      \"min\": 64,\n      \"env_variable\": \"DOCMOST_APP_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Postgres database password\",\n      \"min\": 32,\n      \"env_variable\": \"DOCMOST_PG_PASSWORD\"\n    }\n  ],\n  \"supported_architectures\": [\"arm64\", \"amd64\"],\n  \"created_at\": 1691943801422,\n  \"updated_at\": 1783061948427,\n  \"$schema\": \"../app-info-schema.json\",\n  \"min_tipi_version\": \"4.5.0\"\n}\n"
  },
