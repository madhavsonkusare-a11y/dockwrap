  "promotion": {
    "state": "approved",
    "reason": "Approved by the owner. Qualified as offered on 2026-09-12: a real install of Maxun 0.0.62, upstream's current backend proved it starts, opens to a first screen with a clear next step, survives a restart and a keep-data reinstall with its data and generated credentials intact, and removes everything it created. Local Store wrote this definition from the project's own deployment instructions."
  },
  "data_storage": "Local Store managed folder / maxun",
  "risk_notes": [
    "Creates 5 Docker containers and publishes 3 ports on this computer's loopback interface only.",
    "Its maxun-backend service answers on a second loopback address, which the app's own pages call directly. Local Store opens only the main one.",
    "Its maxun-store service answers on a second loopback address, which the app's own pages call directly. Local Store opens only the main one.",
    "Generates 6 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps its data in this app's managed folder. A keep-data uninstall leaves it; deleting data removes it permanently.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Written by Local Store from the project's own deployment instructions, not taken from an app store.",
    "Asks you to create an account on first open.",
    "Robots load the websites you point them at from this computer, in a headless Chromium that runs with its own sandbox off, as upstream configures it; the container is what contains the pages it loads.",
    "Local Store runs that browser without the SYS_ADMIN capability and unconfined seccomp profile upstream's file asks for, which Chromium without its sandbox does not use.",
    "Screenshots are kept in a bundled RustFS object store, which replaces MinIO now that MinIO no longer publishes images. Telemetry to Maxun's developers is off."
  ],
  "fields": {},
  "definition": "{\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\",\n  \"services\": [\n    {\n      \"name\": \"maxun\",\n      \"image\": \"getmaxun/maxun-frontend:v0.0.58\",\n      \"isMain\": true,\n      \"internalPort\": 5173,\n      \"environment\": [\n        {\n          \"key\": \"FRONTEND_PORT\",\n          \"value\": \"5173\"\n        },\n        {\n          \"key\": \"PUBLIC_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"BACKEND_URL\",\n          \"value\": \"${LOCAL_STORE_URL_MAXUN_BACKEND}\"\n        },\n        {\n          \"key\": \"VITE_BACKEND_URL\",\n          \"value\": \"${LOCAL_STORE_URL_MAXUN_BACKEND}\"\n        }\n      ],\n      \"dependsOn\": {\n        \"maxun-backend\": {\n          \"condition\": \"service_healthy\"\n        }\n      }\n    },\n    {\n      \"name\": \"maxun-backend\",\n      \"image\": \"getmaxun/maxun-backend:v0.0.62\",\n      \"addPorts\": [\n        {\n          \"hostPort\": 8080,\n          \"containerPort\": 8080\n        }\n      ],\n      \"environment\": [\n        {\n          \"key\": \"NODE_ENV\",\n          \"value\": \"production\"\n        },\n        {\n          \"key\": \"JWT_SECRET\",\n          \"value\": \"${MAXUN_JWT_SECRET}\"\n        },\n        {\n          \"key\": \"SESSION_SECRET\",\n          \"value\": \"${MAXUN_SESSION_SECRET}\"\n        },\n        {\n          \"key\": \"ENCRYPTION_KEY\",\n          \"value\": \"${MAXUN_ENCRYPTION_KEY}\"\n        },\n        {\n          \"key\": \"DB_NAME\",\n          \"value\": \"maxun\"\n        },\n        {\n          \"key\": \"DB_USER\",\n          \"value\": \"postgres\"\n        },\n        {\n          \"key\": \"DB_PASSWORD\",\n          \"value\": \"${MAXUN_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"DB_HOST\",\n          \"value\": \"maxun-db\"\n        },\n        {\n          \"key\": \"DB_PORT\",\n          \"value\": \"5432\"\n        },\n        {\n          \"key\": \"MINIO_ENDPOINT\",\n          \"value\": \"maxun-store\"\n        },\n        {\n          \"key\": \"MINIO_PORT\",\n          \"value\": \"9000\"\n        },\n        {\n          \"key\": \"MINIO_ACCESS_KEY\",\n          \"value\": \"${MAXUN_STORE_ACCESS_KEY}\"\n        },\n        {\n          \"key\": \"MINIO_SECRET_KEY\",\n          \"value\": \"${MAXUN_STORE_SECRET_KEY}\"\n        },\n        {\n          \"key\": \"MINIO_PUBLIC_URL\",\n          \"value\": \"${LOCAL_STORE_URL_MAXUN_STORE}\"\n        },\n        {\n          \"key\": \"BACKEND_PORT\",\n          \"value\": \"8080\"\n        },\n        {\n          \"key\": \"FRONTEND_PORT\",\n          \"value\": \"5173\"\n        },\n        {\n          \"key\": \"BACKEND_URL\",\n          \"value\": \"${LOCAL_STORE_URL_MAXUN_BACKEND}\"\n        },\n        {\n          \"key\": \"VITE_BACKEND_URL\",\n          \"value\": \"${LOCAL_STORE_URL_MAXUN_BACKEND}\"\n        },\n        {\n          \"key\": \"PUBLIC_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"VITE_PUBLIC_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"MAXUN_TELEMETRY\",\n          \"value\": \"false\"\n        },\n        {\n          \"key\": \"BROWSER_WS_HOST\",\n          \"value\": \"maxun-browser\"\n        },\n        {\n          \"key\": \"BROWSER_WS_PORT\",\n          \"value\": \"3001\"\n        },\n        {\n          \"key\": \"BROWSER_HEALTH_PORT\",\n          \"value\": \"3002\"\n        },\n        {\n          \"key\": \"PLAYWRIGHT_BROWSERS_PATH\",\n          \"value\": \"/ms-playwright\"\n        },\n        {\n          \"key\": \"CI\",\n          \"value\": \"true\"\n        },\n        {\n          \"key\": \"CONTAINER\",\n          \"value\": \"true\"\n        },\n        {\n          \"key\": \"CHROMIUM_FLAGS\",\n          \"value\": \"--disable-gpu --no-sandbox --headless=new\"\n        }\n      ],\n      \"dependsOn\": {\n        \"maxun-db\": {\n          \"condition\": \"service_healthy\"\n        },\n        \"maxun-store\": {\n          \"condition\": \"service_healthy\"\n        },\n        \"maxun-browser\": {\n          \"condition\": \"service_healthy\"\n        }\n      },\n      \"healthCheck\": {\n        \"test\": [\n          \"CMD\",\n          \"node\",\n          \"-e\",\n          \"fetch('http://127.0.0.1:8080/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))\"\n        ],\n        \"interval\": \"10s\",\n        \"timeout\": \"5s\",\n        \"retries\": 30,\n        \"startPeriod\": \"30s\"\n      }\n    },\n    {\n      \"name\": \"maxun-browser\",\n      \"image\": \"getmaxun/maxun-browser:v0.0.2\",\n      \"environment\": [\n        {\n          \"key\": \"NODE_ENV\",\n          \"value\": \"production\"\n        },\n        {\n          \"key\": \"BROWSER_WS_PORT\",\n          \"value\": \"3001\"\n        },\n        {\n          \"key\": \"BROWSER_HEALTH_PORT\",\n          \"value\": \"3002\"\n        },\n        {\n          \"key\": \"BROWSER_WS_HOST\",\n          \"value\": \"maxun-browser\"\n        },\n        {\n          \"key\": \"PLAYWRIGHT_BROWSERS_PATH\",\n          \"value\": \"/ms-playwright\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": [\n          \"CMD\",\n          \"curl\",\n          \"-f\",\n          \"http://localhost:3002/health\"\n        ],\n        \"interval\": \"10s\",\n        \"timeout\": \"5s\",\n        \"retries\": 6,\n        \"startPeriod\": \"20s\"\n      }\n    },\n    {\n      \"name\": \"maxun-db\",\n      \"image\": \"postgres:17.11\",\n      \"stopSignal\": \"SIGINT\",\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"postgres\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${MAXUN_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"maxun\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/postgres\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": \"pg_isready -U postgres\",\n        \"interval\": \"5s\",\n        \"timeout\": \"5s\",\n        \"retries\": 10,\n        \"startPeriod\": \"60s\"\n      }\n    },\n    {\n      \"name\": \"maxun-store\",\n      \"image\": \"rustfs/rustfs:1.0.0-rc.6\",\n      \"addPorts\": [\n        {\n          \"hostPort\": 9000,\n          \"containerPort\": 9000\n        }\n      ],\n      \"environment\": [\n        {\n          \"key\": \"RUSTFS_ACCESS_KEY\",\n          \"value\": \"${MAXUN_STORE_ACCESS_KEY}\"\n        },\n        {\n          \"key\": \"RUSTFS_SECRET_KEY\",\n          \"value\": \"${MAXUN_STORE_SECRET_KEY}\"\n        },\n        {\n          \"key\": \"RUSTFS_CONSOLE_ENABLE\",\n          \"value\": \"false\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/store\",\n          \"containerPath\": \"/data\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": \"wget -qO- http://localhost:9000/health >/dev/null 2>&1 || exit 1\",\n        \"interval\": \"5s\",\n        \"timeout\": \"3s\",\n        \"retries\": 30\n      }\n    }\n  ]\n}\n",
  "config": {
    "path": "definitions/apps/maxun/config.json",
    "content": "{\n  \"id\": \"maxun\",\n  \"name\": \"Maxun\",\n  \"version\": \"0.0.62\",\n  \"source\": \"https://github.com/getmaxun/maxun\",\n  \"website\": \"https://www.maxun.dev\",\n  \"documentation\": \"https://github.com/getmaxun/maxun/blob/develop/docs/self-hosting-docker.md\",\n  \"short_desc\": \"Turn websites into data: train a robot by pointing at a page, then run it on a schedule.\",\n  \"categories\": [\n    \"Artificial Intelligence\"\n  ],\n  \"license\": \"AGPL-3.0\",\n  \"form_fields\": [\n    {\n      \"type\": \"random\",\n      \"label\": \"Database password\",\n      \"min\": 32,\n      \"max\": 32,\n      \"env_variable\": \"MAXUN_DB_PASSWORD\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Sign-in secret\",\n      \"min\": 64,\n      \"max\": 64,\n      \"env_variable\": \"MAXUN_JWT_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Session secret\",\n      \"min\": 64,\n      \"max\": 64,\n      \"env_variable\": \"MAXUN_SESSION_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Encryption key for stored passwords and proxies\",\n      \"min\": 64,\n      \"max\": 64,\n      \"encoding\": \"hex\",\n      \"env_variable\": \"MAXUN_ENCRYPTION_KEY\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Object store access key\",\n      \"min\": 20,\n      \"max\": 20,\n      \"env_variable\": \"MAXUN_STORE_ACCESS_KEY\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Object store secret key\",\n      \"min\": 40,\n      \"max\": 40,\n      \"env_variable\": \"MAXUN_STORE_SECRET_KEY\"\n    }\n  ]\n}\n"
  }
}
