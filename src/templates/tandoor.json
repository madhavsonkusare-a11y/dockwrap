  "promotion": {
    "state": "approved",
    "reason": "Approved by the owner. Qualified as offered on 2026-09-12: a real install of Tandoor 2.6.15, upstream's current release proved it starts, opens to a first screen with a clear next step, survives a restart and a keep-data reinstall with its data and generated credentials intact, and removes everything it created. Local Store wrote this definition from the project's own deployment instructions."
  },
  "data_storage": "Local Store managed folder / tandoor",
  "risk_notes": [
    "Creates 2 Docker containers and publishes one port on this computer's loopback interface only.",
    "Generates 2 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps its data in this app's managed folder. A keep-data uninstall leaves it; deleting data removes it permanently.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Written by Local Store from the project's own deployment instructions, not taken from an app store.",
    "Asks you to create the first account, which becomes the administrator.",
    "Importing a recipe fetches the page you paste from this computer.",
    "Its first start takes several minutes while it prepares its database, which is why it has a longer allowance."
  ],
  "fields": {},
  "definition": "{\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\",\n  \"services\": [\n    {\n      \"name\": \"tandoor\",\n      \"image\": \"ghcr.io/tandoorrecipes/recipes:2.6.15\",\n      \"isMain\": true,\n      \"internalPort\": 80,\n      \"environment\": [\n        {\n          \"key\": \"SECRET_KEY\",\n          \"value\": \"${TANDOOR_SECRET_KEY}\"\n        },\n        {\n          \"key\": \"ALLOWED_HOSTS\",\n          \"value\": \"localhost,127.0.0.1\"\n        },\n        {\n          \"key\": \"CSRF_TRUSTED_ORIGINS\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"DB_ENGINE\",\n          \"value\": \"django.db.backends.postgresql\"\n        },\n        {\n          \"key\": \"GUNICORN_MEDIA\",\n          \"value\": \"1\"\n        },\n        {\n          \"key\": \"POSTGRES_HOST\",\n          \"value\": \"tandoor-db\"\n        },\n        {\n          \"key\": \"POSTGRES_PORT\",\n          \"value\": \"5432\"\n        },\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"tandoor\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${TANDOOR_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"tandoor\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/staticfiles\",\n          \"containerPath\": \"/opt/recipes/staticfiles\"\n        },\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/mediafiles\",\n          \"containerPath\": \"/opt/recipes/mediafiles\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": \"wget --no-verbose --tries=1 --spider http://localhost:80/accounts/login/\",\n        \"interval\": \"10s\",\n        \"timeout\": \"5s\",\n        \"retries\": 10,\n        \"startPeriod\": \"60s\"\n      },\n      \"dependsOn\": {\n        \"tandoor-db\": {\n          \"condition\": \"service_healthy\"\n        }\n      }\n    },\n    {\n      \"name\": \"tandoor-db\",\n      \"image\": \"postgres:17.11\",\n      \"stopSignal\": \"SIGINT\",\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"tandoor\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${TANDOOR_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"tandoor\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/postgres\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": \"pg_isready -U tandoor -d tandoor\",\n        \"interval\": \"5s\",\n        \"timeout\": \"5s\",\n        \"retries\": 10,\n        \"startPeriod\": \"60s\"\n      }\n    }\n  ]\n}\n",
  "config": {
    "path": "definitions/apps/tandoor/config.json",
    "content": "{\n  \"id\": \"tandoor\",\n  \"name\": \"Tandoor Recipes\",\n  \"version\": \"2.6.15\",\n  \"source\": \"https://github.com/TandoorRecipes/recipes\",\n  \"website\": \"https://tandoor.dev\",\n  \"documentation\": \"https://docs.tandoor.dev/install/docker/\",\n  \"short_desc\": \"Keep your recipes, plan meals and build shopping lists.\",\n  \"categories\": [\n    \"Recipe Management\"\n  ],\n  \"license\": \"AGPL-3.0\",\n  \"form_fields\": [\n    {\n      \"type\": \"random\",\n      \"label\": \"Signing key\",\n      \"min\": 50,\n      \"max\": 50,\n      \"env_variable\": \"TANDOOR_SECRET_KEY\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Database password\",\n      \"min\": 32,\n      \"max\": 32,\n      \"env_variable\": \"TANDOOR_DB_PASSWORD\"\n    }\n  ]\n}\n"
  },
  "first_start_seconds": 600
}
