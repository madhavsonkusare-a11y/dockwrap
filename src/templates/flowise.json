  "promotion": {
    "state": "approved",
    "reason": "Approved by the owner. Qualified as offered on 2026-09-12: a real install of Flowise 3.1.4, upstream's current release proved it starts, opens to a first screen with a clear next step, survives a restart and a keep-data reinstall with its data and generated credentials intact, and removes everything it created. Local Store wrote this definition from the project's own deployment instructions."
  },
  "data_storage": "Local Store managed folder / flowise",
  "risk_notes": [
    "Creates 2 Docker containers and publishes one port on this computer's loopback interface only.",
    "Generates 5 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps its data in this app's managed folder. A keep-data uninstall leaves it; deleting data removes it permanently.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Written by Local Store from the project's own deployment instructions, not taken from an app store.",
    "Asks you to create its administrator account the first time you open it.",
    "Flows call model providers and other services with credentials you store in it; they are encrypted with a key Local Store generated.",
    "Flowise is open core: features for its paid Enterprise edition stay locked.",
    "Keeps its data in PostgreSQL beside it. Flowise 3.1.4 crashes on its own SQLite session store, which is why."
  ],
  "fields": {},
  "definition": "{\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\",\n  \"services\": [\n    {\n      \"name\": \"flowise\",\n      \"image\": \"flowiseai/flowise:3.1.4\",\n      \"isMain\": true,\n      \"internalPort\": 3000,\n      \"environment\": [\n        {\n          \"key\": \"PORT\",\n          \"value\": \"3000\"\n        },\n        {\n          \"key\": \"SECRETKEY_PATH\",\n          \"value\": \"/home/node/.flowise\"\n        },\n        {\n          \"key\": \"LOG_PATH\",\n          \"value\": \"/home/node/.flowise/logs\"\n        },\n        {\n          \"key\": \"BLOB_STORAGE_PATH\",\n          \"value\": \"/home/node/.flowise/storage\"\n        },\n        {\n          \"key\": \"APP_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"JWT_AUTH_TOKEN_SECRET\",\n          \"value\": \"${FLOWISE_JWT_SECRET}\"\n        },\n        {\n          \"key\": \"JWT_REFRESH_TOKEN_SECRET\",\n          \"value\": \"${FLOWISE_JWT_REFRESH_SECRET}\"\n        },\n        {\n          \"key\": \"EXPRESS_SESSION_SECRET\",\n          \"value\": \"${FLOWISE_SESSION_SECRET}\"\n        },\n        {\n          \"key\": \"TOKEN_HASH_SECRET\",\n          \"value\": \"${FLOWISE_TOKEN_HASH_SECRET}\"\n        },\n        {\n          \"key\": \"DISABLE_FLOWISE_TELEMETRY\",\n          \"value\": \"true\"\n        },\n        {\n          \"key\": \"DATABASE_TYPE\",\n          \"value\": \"postgres\"\n        },\n        {\n          \"key\": \"DATABASE_HOST\",\n          \"value\": \"flowise-db\"\n        },\n        {\n          \"key\": \"DATABASE_PORT\",\n          \"value\": \"5432\"\n        },\n        {\n          \"key\": \"DATABASE_NAME\",\n          \"value\": \"flowise\"\n        },\n        {\n          \"key\": \"DATABASE_USER\",\n          \"value\": \"postgres\"\n        },\n        {\n          \"key\": \"DATABASE_PASSWORD\",\n          \"value\": \"${FLOWISE_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"DATABASE_SSL\",\n          \"value\": \"false\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data\",\n          \"containerPath\": \"/home/node/.flowise\"\n        }\n      ],\n      \"dependsOn\": {\n        \"flowise-db\": {\n          \"condition\": \"service_healthy\"\n        }\n      }\n    },\n    {\n      \"name\": \"flowise-db\",\n      \"image\": \"postgres:17.11\",\n      \"stopSignal\": \"SIGINT\",\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"postgres\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${FLOWISE_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"flowise\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/postgres\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": \"pg_isready -U postgres\",\n        \"interval\": \"5s\",\n        \"timeout\": \"5s\",\n        \"retries\": 10,\n        \"startPeriod\": \"60s\"\n      }\n    }\n  ]\n}\n",
  "config": {
    "path": "definitions/apps/flowise/config.json",
    "content": "{\n  \"id\": \"flowise\",\n  \"name\": \"Flowise\",\n  \"version\": \"3.1.4\",\n  \"source\": \"https://github.com/FlowiseAI/Flowise\",\n  \"website\": \"https://flowiseai.com\",\n  \"documentation\": \"https://docs.flowiseai.com/getting-started#docker\",\n  \"short_desc\": \"Build AI agents and chat flows by dragging nodes together.\",\n  \"categories\": [\n    \"Artificial Intelligence\"\n  ],\n  \"license\": \"Apache-2.0 (enterprise folder under a commercial licence)\",\n  \"form_fields\": [\n    {\n      \"type\": \"random\",\n      \"label\": \"Database password\",\n      \"min\": 32,\n      \"max\": 32,\n      \"env_variable\": \"FLOWISE_DB_PASSWORD\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Session token secret\",\n      \"min\": 48,\n      \"max\": 48,\n      \"env_variable\": \"FLOWISE_JWT_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Refresh token secret\",\n      \"min\": 48,\n      \"max\": 48,\n      \"env_variable\": \"FLOWISE_JWT_REFRESH_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Cookie session secret\",\n      \"min\": 48,\n      \"max\": 48,\n      \"env_variable\": \"FLOWISE_SESSION_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Token hashing secret\",\n      \"min\": 48,\n      \"max\": 48,\n      \"env_variable\": \"FLOWISE_TOKEN_HASH_SECRET\"\n    }\n  ]\n}\n"
  }
}
