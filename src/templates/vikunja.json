  "promotion": {
    "state": "approved",
    "reason": "Approved by the owner. Qualified as offered on 2026-09-12: a real install of Vikunja 2.6.0, upstream's current release proved it starts, opens to a first screen with a clear next step, survives a restart and a keep-data reinstall with its data and generated credentials intact, and removes everything it created. The definition comes from Runtipi's app store."
  },
  "data_storage": "Local Store managed folder / vikunja",
  "risk_notes": [
    "Creates 2 Docker containers and publishes one port on this computer's loopback interface only.",
    "Generates 2 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps its data in this app's managed folder. A keep-data uninstall leaves it; deleting data removes it permanently.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Asks you to register the first account; registration stays open unless you turn it off.",
    "Tasks, files and its database live in the app's folder."
  ],
  "fields": {},
  "definition": "{\n  \"services\": [\n    {\n      \"name\": \"vikunja\",\n      \"image\": \"vikunja/vikunja:2.6.0\",\n      \"isMain\": true,\n      \"internalPort\": 3456,\n      \"environment\": [\n        {\n          \"key\": \"VIKUNJA_DATABASE_HOST\",\n          \"value\": \"vikunja-db\"\n        },\n        {\n          \"key\": \"VIKUNJA_DATABASE_PASSWORD\",\n          \"value\": \"${VIKUNJA_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"VIKUNJA_DATABASE_TYPE\",\n          \"value\": \"postgres\"\n        },\n        {\n          \"key\": \"VIKUNJA_DATABASE_USER\",\n          \"value\": \"tipi\"\n        },\n        {\n          \"key\": \"VIKUNJA_DATABASE_DATABASE\",\n          \"value\": \"vikunja\"\n        },\n        {\n          \"key\": \"VIKUNJA_SERVICE_JWTSECRET\",\n          \"value\": \"${VIKUNJA_SERVICE_SECRET}\"\n        },\n        {\n          \"key\": \"VIKUNJA_SERVICE_PUBLICURL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}/\"\n        }\n      ],\n      \"dependsOn\": {\n        \"vikunja-db\": {\n          \"condition\": \"service_healthy\"\n        }\n      },\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/files\",\n          \"containerPath\": \"/app/vikunja/files\"\n        }\n      ]\n    },\n    {\n      \"name\": \"vikunja-db\",\n      \"image\": \"postgres:14\",\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${VIKUNJA_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"tipi\"\n        },\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"vikunja\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/db\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ],\n      \"healthCheck\": {\n        \"interval\": \"5s\",\n        \"timeout\": \"5s\",\n        \"retries\": 5,\n        \"test\": \"pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB\"\n      }\n    }\n  ],\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\"\n}\n",
  "config": {
    "path": "apps/vikunja/config.json",
    "content": "{\n  \"$schema\": \"../app-info-schema.json\",\n  \"name\": \"Vikunja\",\n  \"available\": true,\n  \"exposable\": true,\n  \"dynamic_config\": true,\n  \"port\": 8135,\n  \"id\": \"vikunja\",\n  \"categories\": [\"utilities\"],\n  \"tipi_version\": 33,\n  \"version\": \"2.6.0\",\n  \"description\": \"The Todo-app to organize your life.\",\n  \"short_desc\": \"The Todo-app to organize your life.\",\n  \"author\": \"kolaente\",\n  \"source\": \"https://kolaente.dev/vikunja\",\n  \"website\": \"https://vikunja.io\",\n  \"form_fields\": [\n    {\n      \"type\": \"random\",\n      \"label\": \"Vikunja database password\",\n      \"env_variable\": \"VIKUNJA_DB_PASSWORD\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Vikunja secret\",\n      \"env_variable\": \"VIKUNJA_SERVICE_SECRET\"\n    }\n  ],\n  \"supported_architectures\": [\"arm64\", \"amd64\"],\n  \"created_at\": 1691943801422,\n  \"updated_at\": 1788597336140,\n  \"min_tipi_version\": \"4.5.0\"\n}\n"
