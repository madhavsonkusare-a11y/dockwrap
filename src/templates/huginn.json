  },
  "definition": "{\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\",\n  \"services\": [\n    {\n      \"name\": \"huginn\",\n      \"image\": \"ghcr.io/huginn/huginn:v2026.09.09\",\n      \"isMain\": true,\n      \"internalPort\": 3000,\n      \"environment\": [\n        {\n          \"key\": \"APP_SECRET_TOKEN\",\n          \"value\": \"${HUGINN_SECRET_TOKEN}\"\n        },\n        {\n          \"key\": \"DOMAIN\",\n          \"value\": \"${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"SEED_USERNAME\",\n          \"value\": \"${HUGINN_USERNAME}\"\n        },\n        {\n          \"key\": \"SEED_PASSWORD\",\n          \"value\": \"${HUGINN_PASSWORD}\"\n        },\n        {\n          \"key\": \"SEED_EMAIL\",\n          \"value\": \"${HUGINN_EMAIL}\"\n        },\n        {\n          \"key\": \"DATABASE_ADAPTER\",\n          \"value\": \"mysql2\"\n        },\n        {\n          \"key\": \"DATABASE_HOST\",\n          \"value\": \"huginn-db\"\n        },\n        {\n          \"key\": \"DATABASE_PORT\",\n          \"value\": \"3306\"\n        },\n        {\n          \"key\": \"DATABASE_NAME\",\n          \"value\": \"huginn\"\n        },\n        {\n          \"key\": \"DATABASE_USERNAME\",\n          \"value\": \"huginn\"\n        },\n        {\n          \"key\": \"DATABASE_PASSWORD\",\n          \"value\": \"${HUGINN_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"DATABASE_ENCODING\",\n          \"value\": \"utf8mb4\"\n        }\n      ],\n      \"dependsOn\": {\n        \"huginn-db\": {\n          \"condition\": \"service_healthy\"\n        }\n      }\n    },\n    {\n      \"name\": \"huginn-db\",\n      \"image\": \"mariadb:11.4.13\",\n      \"healthCheck\": {\n        \"test\": \"healthcheck.sh --connect --innodb_initialized\",\n        \"interval\": \"5s\",\n        \"timeout\": \"10s\",\n        \"retries\": 10,\n        \"startPeriod\": \"60s\"\n      },\n      \"environment\": [\n        {\n          \"key\": \"MARIADB_DATABASE\",\n          \"value\": \"huginn\"\n        },\n        {\n          \"key\": \"MARIADB_USER\",\n          \"value\": \"huginn\"\n        },\n        {\n          \"key\": \"MARIADB_PASSWORD\",\n          \"value\": \"${HUGINN_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"MARIADB_RANDOM_ROOT_PASSWORD\",\n          \"value\": \"true\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/mariadb\",\n          \"containerPath\": \"/var/lib/mysql\"\n        }\n      ]\n    }\n  ]\n}\n",
  "config": {
    "path": "definitions/apps/huginn/config.json",
    "content": "{\n  \"id\": \"huginn\",\n  \"name\": \"Huginn\",\n  \"version\": \"2026.09.09\",\n  \"source\": \"https://github.com/huginn/huginn\",\n  \"website\": \"https://github.com/huginn/huginn\",\n  \"documentation\": \"https://github.com/huginn/huginn/blob/master/doc/docker/install.md\",\n  \"short_desc\": \"Agents that watch the web and act on your behalf: an IFTTT you run yourself.\",\n  \"categories\": [\n    \"Automation\"\n  ],\n  \"license\": \"MIT\",\n  \"form_fields\": [\n    {\n      \"type\": \"text\",\n      \"label\": \"Username\",\n      \"min\": 3,\n      \"max\": 40,\n      \"required\": true,\n      \"env_variable\": \"HUGINN_USERNAME\"\n    },\n    {\n      \"type\": \"password\",\n      \"label\": \"Password\",\n      \"min\": 8,\n      \"max\": 80,\n      \"required\": true,\n      \"env_variable\": \"HUGINN_PASSWORD\"\n    },\n    {\n      \"type\": \"email\",\n      \"label\": \"Email\",\n      \"required\": true,\n      \"env_variable\": \"HUGINN_EMAIL\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Session secret\",\n      \"min\": 64,\n      \"max\": 64,\n      \"env_variable\": \"HUGINN_SECRET_TOKEN\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Database password\",\n      \"min\": 32,\n      \"max\": 32,\n      \"env_variable\": \"HUGINN_DB_PASSWORD\"\n    }\n  ]\n}\n"
  }
