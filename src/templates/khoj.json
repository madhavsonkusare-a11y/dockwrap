  "promotion": {
    "state": "approved",
    "reason": "Approved by the owner. Qualified as offered on 2026-09-12: a real install of Khoj 1.42.10, the version upstream's own latest tag installs proved it starts, opens to a first screen with a clear next step, survives a restart and a keep-data reinstall with its data and generated credentials intact, and removes everything it created. Local Store wrote this definition from the project's own deployment instructions."
  },
  "data_storage": "Local Store managed folder / khoj",
  "risk_notes": [
    "Creates 3 Docker containers and publishes one port on this computer's loopback interface only.",
    "Generates 2 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps its data in this app's managed folder. A keep-data uninstall leaves it; deleting data removes it permanently.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Written by Local Store from the project's own deployment instructions, not taken from an app store.",
    "Runs in single-user anonymous mode: it opens straight to the chat, and anyone who can reach the address can use it. The admin email and password you set open its /server/admin page.",
    "Sends questions to the model provider you configure and searches the web through a bundled SearXNG from this computer.",
    "Its code sandbox (Terrarium) is published only as :latest, so it is left out and Khoj cannot run code. Khoj 1.42.10 is what upstream's own :latest installs; 2.0 is still in beta."
  ],
  "fields": {
    "KHOJ_ADMIN_EMAIL": {
      "label": "Admin email",
      "sensitive": false
    },
    "KHOJ_ADMIN_PASSWORD": {
      "label": "Admin password",
      "sensitive": true
    }
  },
  "definition": "{\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\",\n  \"services\": [\n    {\n      \"name\": \"khoj\",\n      \"image\": \"ghcr.io/khoj-ai/khoj:1.42.10\",\n      \"isMain\": true,\n      \"internalPort\": 42110,\n      \"command\": [\n        \"--host=0.0.0.0\",\n        \"--port=42110\",\n        \"--anonymous-mode\",\n        \"--non-interactive\"\n      ],\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"khoj\"\n        },\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"khoj\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${KHOJ_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_HOST\",\n          \"value\": \"khoj-database\"\n        },\n        {\n          \"key\": \"POSTGRES_PORT\",\n          \"value\": \"5432\"\n        },\n        {\n          \"key\": \"KHOJ_DJANGO_SECRET_KEY\",\n          \"value\": \"${KHOJ_SECRET_KEY}\"\n        },\n        {\n          \"key\": \"KHOJ_DEBUG\",\n          \"value\": \"False\"\n        },\n        {\n          \"key\": \"KHOJ_ADMIN_EMAIL\",\n          \"value\": \"${KHOJ_ADMIN_EMAIL}\"\n        },\n        {\n          \"key\": \"KHOJ_ADMIN_PASSWORD\",\n          \"value\": \"${KHOJ_ADMIN_PASSWORD}\"\n        },\n        {\n          \"key\": \"KHOJ_SEARXNG_URL\",\n          \"value\": \"http://khoj-search:8080\"\n        },\n        {\n          \"key\": \"KHOJ_TELEMETRY_DISABLE\",\n          \"value\": \"True\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/config\",\n          \"containerPath\": \"/root/.khoj\"\n        },\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/models\",\n          \"containerPath\": \"/root/.cache/huggingface\"\n        }\n      ],\n      \"dependsOn\": {\n        \"khoj-database\": {\n          \"condition\": \"service_healthy\"\n        },\n        \"khoj-search\": {\n          \"condition\": \"service_started\"\n        }\n      }\n    },\n    {\n      \"name\": \"khoj-database\",\n      \"image\": \"pgvector/pgvector:0.8.6-pg15\",\n      \"stopSignal\": \"SIGINT\",\n      \"healthCheck\": {\n        \"test\": \"pg_isready -U khoj\",\n        \"interval\": \"5s\",\n        \"timeout\": \"10s\",\n        \"retries\": 10,\n        \"startPeriod\": \"60s\"\n      },\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"khoj\"\n        },\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"khoj\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${KHOJ_DB_PASSWORD}\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/database\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ]\n    },\n    {\n      \"name\": \"khoj-search\",\n      \"image\": \"searxng/searxng:2026.9.10-931fd9787\",\n      \"environment\": [\n        {\n          \"key\": \"SEARXNG_BASE_URL\",\n          \"value\": \"http://khoj-search:8080/\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/searxng\",\n          \"containerPath\": \"/etc/searxng\"\n        }\n      ]\n    }\n  ]\n}\n",
  "config": {
    "path": "definitions/apps/khoj/config.json",
    "content": "{\n  \"id\": \"khoj\",\n  \"name\": \"Khoj\",\n  \"version\": \"1.42.10\",\n  \"source\": \"https://github.com/khoj-ai/khoj\",\n  \"website\": \"https://khoj.dev\",\n  \"documentation\": \"https://docs.khoj.dev/get-started/setup\",\n  \"short_desc\": \"An AI second brain: ask questions of your notes, documents and the web, with any model.\",\n  \"categories\": [\n    \"Artificial Intelligence\"\n  ],\n  \"license\": \"AGPL-3.0\",\n  \"form_fields\": [\n    {\n      \"type\": \"email\",\n      \"label\": \"Admin email\",\n      \"required\": true,\n      \"env_variable\": \"KHOJ_ADMIN_EMAIL\"\n    },\n    {\n      \"type\": \"password\",\n      \"label\": \"Admin password\",\n      \"min\": 8,\n      \"max\": 80,\n      \"required\": true,\n      \"env_variable\": \"KHOJ_ADMIN_PASSWORD\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Database password\",\n      \"min\": 32,\n      \"max\": 32,\n      \"env_variable\": \"KHOJ_DB_PASSWORD\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Signing key\",\n      \"min\": 50,\n      \"max\": 50,\n      \"env_variable\": \"KHOJ_SECRET_KEY\"\n    }\n  ]\n}\n"
  },
  "first_start_seconds": 600
}
