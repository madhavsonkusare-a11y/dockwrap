  "promotion": {
    "state": "approved",
    "reason": "Approved by the owner. Qualified as offered on 2026-09-12: a real install of Sim 0.8.33, upstream's current release proved it starts, opens to a first screen with a clear next step, survives a restart and a keep-data reinstall with its data and generated credentials intact, and removes everything it created. Local Store wrote this definition from the project's own deployment instructions."
  },
  "data_storage": "Local Store managed folder / sim",
  "risk_notes": [
    "Creates 6 Docker containers and publishes 2 ports on this computer's loopback interface only.",
    "Its sim-realtime service answers on a second loopback address, which the app's own pages call directly. Local Store opens only the main one.",
    "Runs sim-migrations once each time it starts, and starts the app only if it succeeds.",
    "Generates 5 credentials of its own, keeps them beside the app's data, and reuses them if you reinstall.",
    "Keeps its data in this app's managed folder. A keep-data uninstall leaves it; deleting data removes it permanently.",
    "Proven on Windows with Docker's Linux engine. macOS and Linux hosts are unverified.",
    "Written by Local Store from the project's own deployment instructions, not taken from an app store.",
    "Asks you to create an account on first open; anyone who can reach the address can register one.",
    "Workflows call the model providers and services you add keys for; the keys are stored encrypted with a key Local Store generated."
  ],
  "fields": {},
  "definition": "{\n  \"schemaVersion\": 2,\n  \"$schema\": \"https://schemas.runtipi.io/v2/dynamic-compose.json\",\n  \"services\": [\n    {\n      \"name\": \"sim\",\n      \"image\": \"ghcr.io/simstudioai/simstudio:v0.8.33\",\n      \"isMain\": true,\n      \"internalPort\": 3000,\n      \"environment\": [\n        {\n          \"key\": \"NODE_ENV\",\n          \"value\": \"production\"\n        },\n        {\n          \"key\": \"DATABASE_URL\",\n          \"value\": \"postgresql://postgres:${SIM_DB_PASSWORD}@sim-db:5432/simstudio\"\n        },\n        {\n          \"key\": \"BETTER_AUTH_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"NEXT_PUBLIC_APP_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"BETTER_AUTH_SECRET\",\n          \"value\": \"${SIM_AUTH_SECRET}\"\n        },\n        {\n          \"key\": \"ENCRYPTION_KEY\",\n          \"value\": \"${SIM_ENCRYPTION_KEY}\"\n        },\n        {\n          \"key\": \"INTERNAL_API_SECRET\",\n          \"value\": \"${SIM_INTERNAL_SECRET}\"\n        },\n        {\n          \"key\": \"CRON_SECRET\",\n          \"value\": \"${SIM_CRON_SECRET}\"\n        },\n        {\n          \"key\": \"REDIS_URL\",\n          \"value\": \"redis://sim-redis:6379\"\n        },\n        {\n          \"key\": \"SOCKET_SERVER_URL\",\n          \"value\": \"http://sim-realtime:3002\"\n        },\n        {\n          \"key\": \"NEXT_PUBLIC_SOCKET_URL\",\n          \"value\": \"${LOCAL_STORE_URL_SIM_REALTIME}\"\n        }\n      ],\n      \"dependsOn\": {\n        \"sim-db\": {\n          \"condition\": \"service_healthy\"\n        },\n        \"sim-redis\": {\n          \"condition\": \"service_healthy\"\n        },\n        \"sim-migrations\": {\n          \"condition\": \"service_completed_successfully\"\n        },\n        \"sim-realtime\": {\n          \"condition\": \"service_healthy\"\n        }\n      }\n    },\n    {\n      \"name\": \"sim-realtime\",\n      \"image\": \"ghcr.io/simstudioai/realtime:v0.8.33\",\n      \"addPorts\": [\n        {\n          \"hostPort\": 3002,\n          \"containerPort\": 3002\n        }\n      ],\n      \"environment\": [\n        {\n          \"key\": \"NODE_ENV\",\n          \"value\": \"production\"\n        },\n        {\n          \"key\": \"DATABASE_URL\",\n          \"value\": \"postgresql://postgres:${SIM_DB_PASSWORD}@sim-db:5432/simstudio\"\n        },\n        {\n          \"key\": \"NEXT_PUBLIC_APP_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"BETTER_AUTH_URL\",\n          \"value\": \"${APP_PROTOCOL:-http}://${APP_DOMAIN}\"\n        },\n        {\n          \"key\": \"BETTER_AUTH_SECRET\",\n          \"value\": \"${SIM_AUTH_SECRET}\"\n        },\n        {\n          \"key\": \"INTERNAL_API_SECRET\",\n          \"value\": \"${SIM_INTERNAL_SECRET}\"\n        },\n        {\n          \"key\": \"REDIS_URL\",\n          \"value\": \"redis://sim-redis:6379\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": [\"CMD\", \"curl\", \"-fsS\", \"http://127.0.0.1:3002/health\"],\n        \"interval\": \"10s\",\n        \"timeout\": \"5s\",\n        \"retries\": 6,\n        \"startPeriod\": \"30s\"\n      },\n      \"dependsOn\": {\n        \"sim-db\": {\n          \"condition\": \"service_healthy\"\n        },\n        \"sim-redis\": {\n          \"condition\": \"service_healthy\"\n        },\n        \"sim-migrations\": {\n          \"condition\": \"service_completed_successfully\"\n        }\n      }\n    },\n    {\n      \"name\": \"sim-migrations\",\n      \"image\": \"ghcr.io/simstudioai/migrations:v0.8.33\",\n      \"command\": [\"bun\", \"run\", \"db:migrate\"],\n      \"environment\": [\n        {\n          \"key\": \"DATABASE_URL\",\n          \"value\": \"postgresql://postgres:${SIM_DB_PASSWORD}@sim-db:5432/simstudio\"\n        }\n      ],\n      \"dependsOn\": {\n        \"sim-db\": {\n          \"condition\": \"service_healthy\"\n        }\n      }\n    },\n    {\n      \"name\": \"sim-cron\",\n      \"image\": \"ghcr.io/simstudioai/cron:v0.8.33\",\n      \"environment\": [\n        {\n          \"key\": \"SIM_URL\",\n          \"value\": \"http://sim:3000\"\n        },\n        {\n          \"key\": \"CRON_SECRET\",\n          \"value\": \"${SIM_CRON_SECRET}\"\n        },\n        {\n          \"key\": \"TZ\",\n          \"value\": \"UTC\"\n        }\n      ],\n      \"dependsOn\": [\"sim\"]\n    },\n    {\n      \"name\": \"sim-db\",\n      \"image\": \"pgvector/pgvector:0.8.6-pg17\",\n      \"stopSignal\": \"SIGINT\",\n      \"environment\": [\n        {\n          \"key\": \"POSTGRES_USER\",\n          \"value\": \"postgres\"\n        },\n        {\n          \"key\": \"POSTGRES_PASSWORD\",\n          \"value\": \"${SIM_DB_PASSWORD}\"\n        },\n        {\n          \"key\": \"POSTGRES_DB\",\n          \"value\": \"simstudio\"\n        }\n      ],\n      \"volumes\": [\n        {\n          \"hostPath\": \"${APP_DATA_DIR}/data/postgres\",\n          \"containerPath\": \"/var/lib/postgresql/data\"\n        }\n      ],\n      \"healthCheck\": {\n        \"test\": \"pg_isready -U postgres\",\n        \"interval\": \"5s\",\n        \"timeout\": \"5s\",\n        \"retries\": 10,\n        \"startPeriod\": \"60s\"\n      }\n    },\n    {\n      \"name\": \"sim-redis\",\n      \"image\": \"redis:7.4.11-alpine\",\n      \"healthCheck\": {\n        \"test\": [\"CMD\", \"redis-cli\", \"ping\"],\n        \"interval\": \"5s\",\n        \"timeout\": \"5s\",\n        \"retries\": 5\n      }\n    }\n  ]\n}\n",
  "config": {
    "path": "definitions/apps/sim/config.json",
    "content": "{\n  \"id\": \"sim\",\n  \"name\": \"Sim\",\n  \"version\": \"0.8.33\",\n  \"source\": \"https://github.com/simstudioai/sim\",\n  \"website\": \"https://www.sim.ai\",\n  \"documentation\": \"https://docs.sim.ai/self-hosting/docker\",\n  \"short_desc\": \"Build and run AI agent workflows on a visual canvas.\",\n  \"categories\": [\n    \"Artificial Intelligence\"\n  ],\n  \"license\": \"Apache-2.0\",\n  \"form_fields\": [\n    {\n      \"type\": \"random\",\n      \"label\": \"Database password\",\n      \"min\": 32,\n      \"max\": 32,\n      \"env_variable\": \"SIM_DB_PASSWORD\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Sign-in secret\",\n      \"min\": 64,\n      \"max\": 64,\n      \"encoding\": \"hex\",\n      \"env_variable\": \"SIM_AUTH_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Encryption key for stored credentials\",\n      \"min\": 64,\n      \"max\": 64,\n      \"encoding\": \"hex\",\n      \"env_variable\": \"SIM_ENCRYPTION_KEY\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Secret between Sim's services\",\n      \"min\": 64,\n      \"max\": 64,\n      \"encoding\": \"hex\",\n      \"env_variable\": \"SIM_INTERNAL_SECRET\"\n    },\n    {\n      \"type\": \"random\",\n      \"label\": \"Secret for scheduled jobs\",\n      \"min\": 64,\n      \"max\": 64,\n      \"encoding\": \"hex\",\n      \"env_variable\": \"SIM_CRON_SECRET\"\n    }\n  ]\n}\n"
  }
}
